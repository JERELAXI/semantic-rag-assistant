POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=semantic_rag

# Embedding provider — "openai" (default) or "nvidia"
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1536

# NVIDIA NIM (required when EMBEDDING_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Reranker (uses NVIDIA NIM /ranking endpoint)
RERANKER_ENABLED=true
RERANKER_TOP_K=5
