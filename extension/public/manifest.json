{
  "manifest_version": 3,
  "name": "Semantic RAG Assistant",
  "version": "1.0.0",
  "description": "Chat with your knowledge bases while browsing",
  "permissions": ["sidePanel", "activeTab", "storage", "tabs", "scripting"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Semantic RAG"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
