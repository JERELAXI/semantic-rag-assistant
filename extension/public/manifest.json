{
  "manifest_version": 3,
  "name": "Semantic RAG Assistant",
  "version": "1.0.0",
  "description": "Chat with your knowledge bases while browsing",
  "permissions": ["sidePanel", "activeTab", "storage", "tabs", "scripting"],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Semantic RAG",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
